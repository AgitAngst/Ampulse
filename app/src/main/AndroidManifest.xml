<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Напоминания о приёмах (anvil/docs/ANDROID.md, §2, §10). Сейчас сборка одна — github, поэтому разрешения в общем
        манифесте. Когда появится play: SCHEDULE_EXACT_ALARM и USE_FULL_SCREEN_INTENT Google Play разрешает не всем —
        перенести их в src/play/AndroidManifest.xml с объяснением в консоли; запасной путь в коде уже есть
        (неточный будильник и обычное уведомление вместо экрана на весь экран).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Сканер упаковки читает код камерой на телефоне; камеры может не быть — без неё всё остальное работает. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Диктовка назначения: микрофон нужен только для неё; микрофона может не быть — без него остальное работает. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Видимость пакетов (Android 11+): без этого isRecognitionAvailable не увидит службу распознавания речи. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!--
        Тонометр по Bluetooth LE (этап 0.7). С Android 12 — поиск без доступа к местоположению (neverForLocation);
        до 12 поиск BLE требует местоположения — только на этих версиях. Bluetooth может не быть — ввод руками остаётся.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Облачная копия выключена (здоровье — личные данные), перенос между телефонами — можно (anvil/docs/ANDROID.md, §10). -->
    <application
        android:name=".AmpulseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Сообщение врача из мессенджера: «Поделиться» → Ampulse — открывается разбор назначения. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Снимок рецепта с камеры: камера пишет в файл кэша (res/xml/file_paths.xml) только через этот провайдер. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Экран «Напоминание» важного лекарства: поверх блокировки, тёмный в любой теме; открывает его только уведомление. -->
        <activity
            android:name=".reminders.ReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:turnScreenOn="true" />

        <!--
            Экстренная карта поверх экрана блокировки (этап 0.8): только чтение, без перехода в программу. Открывает её
            постоянное уведомление «Экстренная карта»; showWhenLocked — и чтобы система не просила разблокировать при
            касании уведомления. Не экспортирована и не в списке недавних.
        -->
        <activity
            android:name=".ui.EmergencyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Будильники приёмов и суточный пересчёт: будит только AlarmManager через свои PendingIntent. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Кнопки «Принять» и «Отложить» в уведомлении. -->
        <receiver
            android:name=".reminders.ActionReceiver"
            android:exported="false" />

        <!--
            Пересчёт будильников после перезагрузки, смены времени и часового пояса, обновления программы и выдачи права
            на точные будильники. Принимает системные рассылки, поэтому exported; чужие действия приёмник отбрасывает.
        -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
