<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: в облачную копию Google ничего не уходит; при переносе на новый телефон данные переезжают. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <!-- Токен входа на свой сервер на другой телефон не переезжает: там войдите заново. -->
        <exclude domain="sharedpref" path="server_sync_secret.xml" />
    </device-transfer>
</data-extraction-rules>
