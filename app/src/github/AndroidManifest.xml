<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Только сборка github: SMS близкому уходит сама (пропуск важного приёма, открытая экстренная карта, этап 0.8).
        Google Play SEND_SMS почти никому не даёт — там SMS идёт через приложение сообщений (Store.sendSms).
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
        Только сборка github: сеть. Обновление из GitHub и необязательный свой сервер («Сервер» в настройках, зеркало).
        Явно, а не «по случаю» от библиотек: выгрузка на сервер ходит сама. В rustore и play сети нет (src/*/AndroidManifest.xml).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
</manifest>
